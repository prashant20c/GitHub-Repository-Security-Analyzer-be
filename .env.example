APP_NAME="GitHub Repository Security Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5174

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=security_analyzer
DB_USERNAME=security_analyzer
DB_PASSWORD=security_analyzer

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Set a real OpenAI API key to enable AI recommendations, summaries, and code scanning.
OPENAI_API_KEY=
# GPT-4.1 mini supports structured JSON output and is a low-latency default for scans.
OPENAI_MODEL=gpt-4.1-mini
# Override only when using a compatible OpenAI API proxy.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CODE_SCAN_ENABLED=true
OPENAI_CODE_SCAN_MAX_FILES=60
OPENAI_CODE_SCAN_MAX_FILE_BYTES=12000
OPENAI_CODE_SCAN_MAX_TOTAL_BYTES=120000
OPENAI_CODE_SCAN_TIMEOUT_SECONDS=90

PYTHON_ANALYTICS_PATH=backend/python-analytics
SCAN_TIMEOUT_SECONDS=900
MAX_REPOSITORY_SIZE_MB=250

GITHUB_SCAN_BASE_PATH=storage/app/scans

# Mailgun HTTP API
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME="GitHub Repository Security Analyzer"
# Use https://api.eu.mailgun.net for EU-region sending domains.
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_TIMEOUT_SECONDS=20
MAILGUN_VERIFICATION_TEMPLATE=verify-email

# External API audit logging. Request payloads are disabled by default because they may contain source code.
EXTERNAL_API_LOGGING_ENABLED=true
EXTERNAL_API_LOG_REQUEST_PAYLOADS=false
EXTERNAL_API_LOG_RESPONSE_PAYLOADS=true
EXTERNAL_API_LOG_MAX_PAYLOAD_BYTES=10000
